layout: layouts/base.njk
title: Work
permalink: /work/
description: Engineering and product leadership in Tokyo — Third Intelligence, TIFIN Japan, Google Maps, Mercari, Presto.
---

{# Rendered from _data/cv.json. Update that file from the CV; don't edit roles
   into this template.

   The detail column is the page. The rail beside it is orientation — it shows
   that the community work has run alongside the paid work for a decade, which
   a pair of lists cannot, and it highlights whichever entry you are reading. #}

<div class="work">

  <div class="work-main">
    <article class="article">
      <h1>Work</h1>
      <p class="byline">Tokyo &middot; {{ cv.languages }}</p>
      <p class="work-summary">{{ cv.summary }}</p>

      <section class="cv">
        <h2 class="section-head">Experience</h2>
        {%- for job in cv.experience %}
        <div class="cv-entry" data-key="{{ job | key }}">
          <div class="cv-when"><time>{{ job.dates }}</time></div>
          <div class="cv-what">
            <h3>{{ job.role }}<span class="cv-org">{{ job.org }}</span></h3>
            {%- if job.note %}<p class="cv-note">{{ job.note }}</p>{% endif %}
            <ul>
              {%- for b in job.bullets %}
              <li>{{ b }}</li>
              {%- endfor %}
            </ul>
          </div>
        </div>
        {%- endfor %}
      </section>

      <section class="cv">
        <h2 class="section-head">Community</h2>
        <p class="cv-intro">Close to a second career, and overlapping the first for most of a
        decade — Discover Nikkei alone has run through four other roles.</p>
        {%- for job in cv.community %}
        <div class="cv-entry" data-key="{{ job | key }}">
          <div class="cv-when"><time>{{ job.dates }}</time></div>
          <div class="cv-what">
            <h3>{{ job.role }}<span class="cv-org">{{ job.org }}</span></h3>
            {%- if job.note %}<p class="cv-note">{{ job.note }}</p>{% endif %}
            <ul>
              {%- for b in job.bullets %}
              <li>{{ b }}</li>
              {%- endfor %}
            </ul>
          </div>
        </div>
        {%- endfor %}
      </section>

      <section class="cv">
        <h2 class="section-head">Earlier</h2>
        <div class="cv-entry">
          <div class="cv-when"><time>{{ cv.earlier.range }}</time></div>
          <div class="cv-what"><p>{{ cv.earlier.text }}</p></div>
        </div>
      </section>

      <section class="cv">
        <h2 class="section-head">Education</h2>
        {%- for e in cv.education %}
        <div class="cv-entry">
          <div class="cv-when"><time>{{ e.year }}</time></div>
          <div class="cv-what">
            <h3>{{ e.credential }}<span class="cv-org">{{ e.school }}</span></h3>
            {%- if e.note %}<p class="cv-note">{{ e.note }}</p>{% endif %}
          </div>
        </div>
        {%- endfor %}
      </section>
    </article>
  </div>

  {% timeline cv %}

</div>

{#- Highlights the rail bar for whichever entry is in view. Progressive: with
    no JS the rail still renders correctly, it just doesn't follow along. -#}
<script>
(() => {
  const track = document.querySelector('.worktrack');
  if (!track) return;
  const bars = new Map([...track.querySelectorAll('.track-bar')].map((b) => [b.dataset.key, b]));
  const entries = [...document.querySelectorAll('.cv-entry[data-key]')];
  if (!bars.size || !entries.length) return;

  // A plain scroll handler, throttled by timestamp rather than by
  // requestAnimationFrame or IntersectionObserver. Both of those are suspended
  // in a hidden document, which makes the behaviour untestable in a headless
  // pane; measuring eleven rectangles is cheap enough that the difference does
  // not matter here.
  let last = 0;
  const update = () => {
    last = Date.now();
    const mid = innerHeight / 2;
    const band = innerHeight * 0.1;          // entries crossing the middle tenth

    // Two different jobs, deliberately separated. Every entry in the band is
    // marked current, so the bars keep showing how many commitments ran at
    // once — three deep in 2023 is a fact worth seeing. But only the entry
    // nearest the middle is named, which makes label collision impossible
    // however many overlap.
    const lit = new Set();
    let nearest = null, nearestDist = Infinity;
    for (const el of entries) {
      const r = el.getBoundingClientRect();
      if (r.top < mid + band && r.bottom > mid - band) {
        lit.add(el.dataset.key);
        const dist = Math.abs((r.top + r.bottom) / 2 - mid);
        if (dist < nearestDist) { nearestDist = dist; nearest = el.dataset.key; }
      }
    }
    for (const [key, bar] of bars) {
      bar.classList.toggle('is-current', lit.has(key));
      bar.classList.toggle('is-named', key === nearest);
    }
  };
  const schedule = () => {
    const now = Date.now();
    if (now - last >= 16) update(); else setTimeout(update, 16 - (now - last));
  };

  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);
  update();
})();
</script>
