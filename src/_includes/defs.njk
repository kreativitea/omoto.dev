{# Shared SVG filter definitions. Included once per page.

   Keep an eye on the total number of live filters in a viewport: high-frequency
   turbulence over a large filter region makes Chromium silently fail to
   rasterise — the region paints blank while the DOM lays out perfectly.
   Grain stays at numOctaves 2; regions stay tight. #}
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>

  {# Dry brush. Displacement scale must stay small relative to the stroke's
     height, or the mark dissolves into fuzz rather than fraying. #}
  <filter id="dry1" x="-20%" y="-70%" width="140%" height="240%">
    <feTurbulence type="fractalNoise" baseFrequency=".055 .012" numOctaves="4" seed="5" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5" xChannelSelector="R" yChannelSelector="G"/>
  </filter>

  {# Carved stone edge, for the seal and the practice row. #}
  <filter id="carve" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency=".11" numOctaves="4" seed="33" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="3.4" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
  <filter id="carve-rough" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency=".14" numOctaves="4" seed="9" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="5.5" xChannelSelector="R" yChannelSelector="G"/>
  </filter>

  {# Wet wash, for the static splash behind the wordmark. Post illustrations
     don't use these — lib/wash.js emits its own per-figure filters with unique
     ids, so two figures on a page can't inherit each other's warp. Warp
     frequency is matched to this element's size; a lower frequency with a
     bigger scale facets the ellipse into a polygon. #}
  <filter id="nw-a" x="-22%" y="-28%" width="144%" height="156%">
    <feTurbulence type="fractalNoise" baseFrequency=".026" numOctaves="4" seed="21" result="warp"/>
    <feDisplacementMap in="SourceGraphic" in2="warp" scale="17" xChannelSelector="R" yChannelSelector="G"/>
    <feGaussianBlur stdDeviation=".7" result="shape"/>
    <feTurbulence type="fractalNoise" baseFrequency=".4" numOctaves="2" seed="14" result="grain"/>
    <feColorMatrix in="grain" type="saturate" values="0" result="grey"/>
    <feComponentTransfer in="grey" result="soft">
      <feFuncR type="linear" slope=".28" intercept=".72"/>
      <feFuncG type="linear" slope=".28" intercept=".72"/>
      <feFuncB type="linear" slope=".28" intercept=".72"/>
    </feComponentTransfer>
    <feComposite in="soft" in2="shape" operator="in" result="grainIn"/>
    <feBlend in="shape" in2="grainIn" mode="multiply"/>
  </filter>
  <filter id="nw-b" x="-22%" y="-28%" width="144%" height="156%">
    <feTurbulence type="fractalNoise" baseFrequency=".032" numOctaves="4" seed="77" result="warp"/>
    <feDisplacementMap in="SourceGraphic" in2="warp" scale="13" xChannelSelector="R" yChannelSelector="G"/>
    <feGaussianBlur stdDeviation="1.5"/>
  </filter>
  <filter id="nw-c" x="-22%" y="-28%" width="144%" height="156%">
    <feTurbulence type="fractalNoise" baseFrequency=".04" numOctaves="3" seed="140" result="warp"/>
    <feDisplacementMap in="SourceGraphic" in2="warp" scale="10" xChannelSelector="R" yChannelSelector="G"/>
    <feGaussianBlur stdDeviation="2.6"/>
  </filter>

  {# Painted line, for the 青海波 and 麻の葉 motifs. The wash filters above are
     built for large filled shapes; their 2.6px blur turns a 1.2px stroke into a
     grey smudge. Fine line work needs a small displacement and barely any blur
     — enough to look drawn rather than printed, not enough to erase it. #}
  <filter id="wet-line" x="-18%" y="-18%" width="136%" height="136%">
    <feTurbulence type="fractalNoise" baseFrequency=".05" numOctaves="3" seed="11" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" xChannelSelector="R" yChannelSelector="G"/>
    <feGaussianBlur stdDeviation=".35"/>
  </filter>
  {# Pencil, for marginalia arrows. #}
  <filter id="pen" x="-15%" y="-120%" width="130%" height="340%">
    <feTurbulence type="fractalNoise" baseFrequency=".05" numOctaves="3" seed="3" result="n"/>
    <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G"/>
  </filter>

  {# The torn edge used by the bands and disc in the post figures is NOT here:
     lib/wash.js emits its own per figure, with an id derived from the seed, so
     that two figures on one page cannot inherit each other's warp. A shared
     definition would be the third thing on this page fighting for that id. #}

</defs></svg>
