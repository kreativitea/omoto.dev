<!doctype html>
<html lang="{{ site.locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ '/feed.xml' | rel(absoluteAssets) }}">
<link rel="stylesheet" href="{{ '/assets/css/site.css' | rel(absoluteAssets) }}">
{%- if absoluteAssets %}
{# A 404's absolute stylesheet path only resolves at the apex, so this keeps
   the page presentable under any other mount. #}
<style>
  body{margin:0;background:#faf7f1;color:#2b2926;
    font:17px/1.85 'Hoefler Text',Baskerville,Georgia,serif}
  .page{max-width:36rem;margin:0 auto;padding:6rem 2rem}
</style>
{%- endif %}
<meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

{% include "defs.njk" %}

<div class="page">

  <header class="masthead">
    <div>
      <h1 class="wordmark">
        <a class="np" href="{{ '/' | rel(absoluteAssets) }}">
          {# Western: a loose wet wash under the name — pooled edge, and one
             highlight where the paint is still shining. The fill and the
             pooled edge drift on separate clocks, so the pigment is never
             quite where its own rim says it should be. #}
          <svg class="name-wash" width="340" height="48" viewBox="0 0 340 48" preserveAspectRatio="none" aria-hidden="true">
            <g style="mix-blend-mode:var(--wash-blend)">
              <ellipse cx="170" cy="25" rx="156" ry="15" fill="#7fa6c8" opacity=".38" filter="url(#nw-a)"/>
              <ellipse cx="126" cy="28" rx="102" ry="11" fill="#a58fc0" opacity=".28" filter="url(#nw-b)"/>
              <ellipse cx="236" cy="21" rx="70"  ry="9"  fill="#8fbf9c" opacity=".26" filter="url(#nw-c)"/>
            </g>
            <ellipse cx="170" cy="25" rx="156" ry="15" fill="none" stroke="#3f6f9c" stroke-width="2"
                     opacity=".3" filter="url(#nw-a)" style="mix-blend-mode:var(--wash-blend)"/>
            <ellipse cx="116" cy="17" rx="40" ry="5" fill="#fff" opacity=".32" style="mix-blend-mode:screen"/>
          </svg>
          Michael <span class="mid">Toshiro</span> Omoto</a>
        {# Ruby, not bare hiragana: on a practice-sheet site a reading aid earns
           its place — it is the thing the sheet is for. #}
        <span class="reading" lang="ja"><ruby>{%- for r in site.nameJaRuby -%}{{ r.base }}<rt>{{ r.rt }}</rt>{%- endfor -%}</ruby></span>
      </h1>

      {# One stroke, laid down three times. The outline is tapered — thin where
         the brush lands, fat through the middle, thin as it lifts — and the
         white streaks are kasure (掠れ), paper showing through where the ink
         ran out.

         The geometry is authored once into <defs> and stamped three times with
         a different dry-brush seed each, so the boil costs three filters and
         one copy of the path data rather than three of each. #}
      <svg class="brush" width="440" height="26" viewBox="0 0 440 26" aria-hidden="true">
        <defs>
          <g id="brush-mark">
            <path d="M8 12 C 80 4.6, 170 9.6, 250 11.6 C 320 13.4, 380 10.6, 424 8.6
                     C 430 8.3, 434 9.2, 436 10.6
                     L 433 17.6 C 427 19.2, 417 20, 405 19.6 C 365 18.2, 315 21.6, 245 19.6
                     C 165 17.4, 77 20.6, 8 18.6 Z" fill="currentColor"/>
            {# a second pass over the first, the way a loaded brush doubles back #}
            <path d="M120 13 C 200 8, 300 16, 400 11" fill="none" stroke="currentColor"
                  stroke-width="2.4" opacity=".3"/>
            <g stroke="var(--paper)" fill="none">
              <path d="M320 14 H 436" stroke-width="1.5" stroke-dasharray="10 4 2 7 2 11"/>
              <path d="M352 16.4 H 434" stroke-width="1.3" stroke-dasharray="6 5 3 8"/>
              <path d="M386 18.4 H 432" stroke-width="1.1" stroke-dasharray="4 6 2 5"/>
              <path d="M56 15 H 148" stroke-width=".9" stroke-dasharray="17 33" opacity=".55"/>
            </g>
          </g>
        </defs>
        <g style="mix-blend-mode:var(--wash-blend)" opacity=".82">
          {%- for f in ["dry1","dry2","dry3"] %}
          <g><use href="#brush-mark" filter="url(#{{ f }})"/></g>
          {%- endfor %}
        </g>
      </svg>

      <p class="role">{{ site.role }}</p>
    </div>

    {% include "seal.njk" %}
  </header>

  <nav class="rail" aria-label="Primary">
    {%- for item in site.nav %}
    <a href="{{ item.url | rel(absoluteAssets) }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>

  <main id="main">
    {{ content | safe }}
  </main>

  {# The same character, five times, getting better. #}
  <div class="practice-row" aria-hidden="true">
    {%- for a in [
      {o:".17", r:"-3",   f:"carve-rough"},
      {o:".26", r:"2",    f:"carve-rough"},
      {o:".38", r:"-1.4", f:"carve"},
      {o:".54", r:".8",   f:"carve"},
      {o:".82", r:"0",    f:""}
    ] %}
    <svg width="58" height="58" viewBox="0 0 60 60"><g {% if a.f %}filter="url(#{{ a.f }})" {% endif %}opacity="{{ a.o }}" transform="rotate({{ a.r }} 30 30)">
      <text x="30" y="46" text-anchor="middle" font-size="40" fill="currentColor">敏</text>
    </g></svg>
    {%- endfor %}
    <span class="caption">&larr; keep practising</span>
  </div>

  <footer class="colophon">
    <span>{{ site.name }} &middot; Tokyo</span>
    <ul>
      {%- for s in site.social %}
      <li><a href="{{ s.url }}"{% if '://' in s.url %} rel="me"{% endif %}>{{ s.label }}</a></li>
      {%- endfor %}
    </ul>
  </footer>

  {# 青海波 (seigaiha) — overlapping wave scales, the oldest of the wagara
     patterns, closing the page as a border. A tiling background rather than a
     wide inline SVG: a displacement filter stretched the full width of the
     viewport is the exact shape that makes Chromium give up rasterising, and
     seigaiha is a stencil pattern, so a regular repeat is truer to it than a
     hand-wobbled one would be. #}
  <div class="wave-border" aria-hidden="true"></div>

</div>
</body>
</html>
