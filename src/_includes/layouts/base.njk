<!doctype html>
<html lang="{{ site.locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ '/feed.xml' | rel(absoluteAssets) }}">
<link rel="stylesheet" href="{{ '/assets/css/site.css' | rel(absoluteAssets) }}">
{%- if absoluteAssets %}
{# A 404's absolute stylesheet path only resolves at the apex, so this keeps
   the page presentable under any other mount. #}
<style>
  body{margin:0;background:#faf7f1;color:#2b2926;
    font:17px/1.85 'Hoefler Text',Baskerville,Georgia,serif}
  .page{max-width:36rem;margin:0 auto;padding:6rem 2rem}
</style>
{%- endif %}
<meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

{% include "defs.njk" %}

<div class="page">

  <header class="masthead">
    <div>
      <h1 class="wordmark">
        <a class="np" href="{{ '/' | rel(absoluteAssets) }}">
          {# Western: a loose wet wash under the name — pooled edge, and one
             highlight where the paint is still shining. The fill and the
             pooled edge drift on separate clocks, so the pigment is never
             quite where its own rim says it should be. #}
          <svg class="name-wash" width="340" height="48" viewBox="0 0 340 48" preserveAspectRatio="none" aria-hidden="true">
            <g style="mix-blend-mode:var(--wash-blend)">
              <ellipse cx="170" cy="25" rx="156" ry="15" fill="#7fa6c8" opacity=".38" filter="url(#nw-a)"/>
              <ellipse cx="126" cy="28" rx="102" ry="11" fill="#a58fc0" opacity=".28" filter="url(#nw-b)"/>
              <ellipse cx="236" cy="21" rx="70"  ry="9"  fill="#8fbf9c" opacity=".26" filter="url(#nw-c)"/>
            </g>
            <ellipse cx="170" cy="25" rx="156" ry="15" fill="none" stroke="#3f6f9c" stroke-width="2"
                     opacity=".3" filter="url(#nw-a)" style="mix-blend-mode:var(--wash-blend)"/>
            <ellipse cx="116" cy="17" rx="40" ry="5" fill="#fff" opacity=".32" style="mix-blend-mode:screen"/>
          </svg>
          Michael <span class="mid">Toshiro</span> Omoto</a>
        {# Ruby, not bare hiragana: on a practice-sheet site a reading aid earns
           its place — it is the thing the sheet is for. #}
        <span class="reading" lang="ja"><ruby>{%- for r in site.nameJaRuby -%}{{ r.base }}<rt>{{ r.rt }}</rt>{%- endfor -%}</ruby></span>
      </h1>

      {# One stroke, running the full width of the window.

         preserveAspectRatio="none" with a locked height is load-bearing. The
         default (meet) scales uniformly, so a stroke stretched to a wider
         window would get proportionally FATTER — the same mistake as scaling
         the whole mark instead of lengthening it. Stretching x alone keeps the
         ink the same weight against type that is not scaling either, and a
         near-horizontal mark tolerates it: what stretches is the travel, which
         is exactly the thing that should.

         The viewBox is trimmed to where the ink actually ends, so the mark
         spans edge to edge rather than stopping short inside a padded box.

         Tucked at the entry, swelling through the middle, lifting to a point.
         The white streaks are kasure (掠れ) and run WITH the stroke, because
         bristles separate lengthwise. Generated from a centreline and a
         pressure profile, then baked — regenerate to revise, don't hand-edit. #}
      <svg class="brush" width="1356" height="26" viewBox="0 0 1356 26"
           preserveAspectRatio="none" aria-hidden="true">
