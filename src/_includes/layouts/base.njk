 4.3L676.0 4.4L664.3 4.5L652.5 4.6L640.8 4.6L629.1 4.6L617.3 4.6L605.6 4.6L593.9 4.5L582.2 4.4L570.5 4.3L558.8 4.2L547.1 4.1L535.4 4.1L523.8 4.0L512.1 4.0L500.5 4.0L488.8 4.0L477.2 4.0L465.6 3.9L454.0 3.9L442.4 3.9L430.9 3.9L419.3 3.9L407.8 3.9L396.3 4.0L384.8 4.1L373.4 4.2L361.9 4.4L350.5 4.5L339.1 4.7L327.7 4.8L316.4 5.0L305.1 5.1L293.8 5.2L282.5 5.3L271.2 5.5L260.0 5.6L248.8 5.8L237.7 5.9L226.5 6.1L215.4 6.3L204.3 6.5L193.3 6.7L182.3 6.9L171.3 7.1L160.4 7.4L149.5 7.6L138.6 7.9L127.8 8.2L117.0 8.5L106.2 8.8L95.5 9.1L84.8 9.4L74.2 9.8L63.6 10.2L53.1 10.6L42.6 11.0L32.1 11.5L21.7 12.1L11.3 12.8L1.0 14.1Z" fill="currentColor"/>
          <g stroke="var(--paper)" fill="none" stroke-linecap="round">
            <path d="M844.9 13.2L855.7 13.2L866.5 13.1L877.2 13.0L888.0 13.0L898.8 12.9L909.5 12.8L920.3 12.8L931.0 12.7L941.7 12.7L952.4 12.6L963.1 12.5L973.8 12.5L984.4 12.4L995.1 12.4L1005.7 12.3L1016.3 12.2L1026.9 12.2L1037.5 12.1L1048.1 12.0L1058.6 12.0L1069.1 11.9L1079.6 11.8L1090.1 11.8L1100.5 11.7L1111.0 11.7L1121.4 11.6L1131.7 11.5L1142.1 11.5L1152.4 11.4L1162.8 11.3L1173.0 11.2L1183.3 11.1L1193.5 11.0L1203.7 10.9L1213.9 10.8L1224.1 10.7L1234.2 10.5L1244.3 10.4L1254.3 10.3L1264.3 10.2L1274.3 10.1L1284.3 10.0L1294.2 9.9L1304.1 9.8L1314.0 9.7L1323.8 9.6L1333.6 9.5L1343.3 9.3" stroke-width="1.4" stroke-dasharray="9 5 3 8 2 12"/>
            <path d="M984.1 8.8L991.9 8.8L999.7 8.8L1007.4 8.8L1015.2 8.8L1022.9 8.8L1030.6 8.8L1038.3 8.8L1046.0 8.8L1053.7 8.8L1061.4 8.8L1069.1 8.8L1076.8 8.8L1084.4 8.8L1092.0 8.7L1099.7 8.7L1107.3 8.7L1114.9 8.7L1122.5 8.7L1130.1 8.7L1137.6 8.6L1145.2 8.6L1152.7 8.6L1160.2 8.6L1167.8 8.6L1175.2 8.6L1182.7 8.6L1190.2 8.6L1197.7 8.6L1205.1 8.6L1212.5 8.6L1219.9 8.6L1227.3 8.5L1234.7 8.5L1242.1 8.5L1249.4 8.5L1256.7 8.5L1264.1 8.4L1271.3 8.4L1278.6 8.4L1285.9 8.4L1293.1 8.3L1300.4 8.3L1307.6 8.3L1314.8 8.2L1321.9 8.2L1329.1 8.2L1336.2 8.2L1343.3 8.1" stroke-width="1.1" stroke-dasharray="5 6 3 9"/>
          </g>
        </g>
      </svg>

      <p class="role">{{ site.role }}</p>
    </div>

    {% include "seal.njk" %}
  </header>

  <nav class="rail" aria-label="Primary">
    {%- for item in site.nav %}
    <a href="{{ item.url | rel(absoluteAssets) }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>

  <main id="main">
    {{ content | safe }}
  </main>

  {# The same character, five times, getting better. #}
  <div class="practice-row" aria-hidden="true">
    {%- for a in [
      {o:".17", r:"-3",   f:"carve-rough"},
      {o:".26", r:"2",    f:"carve-rough"},
      {o:".38", r:"-1.4", f:"carve"},
      {o:".54", r:".8",   f:"carve"},
      {o:".82", r:"0",    f:""}
    ] %}
    <svg width="58" height="58" viewBox="0 0 60 60"><g {% if a.f %}filter="url(#{{ a.f }})" {% endif %}opacity="{{ a.o }}" transform="rotate({{ a.r }} 30 30)">
      <text x="30" y="46" text-anchor="middle" font-size="40" fill="currentColor">敏</text>
    </g></svg>
    {%- endfor %}
    <span class="caption">&larr; keep practising</span>
  </div>

  <footer class="colophon">
    <span>{{ site.name }} &middot; Tokyo</span>
    <ul>
      {%- for s in site.social %}
      <li><a href="{{ s.url }}"{% if '://' in s.url %} rel="me"{% endif %}>{{ s.label }}</a></li>
      {%- endfor %}
    </ul>
  </footer>

  {# 青海波 (seigaiha) — overlapping wave scales, the oldest of the wagara
     patterns, closing the page as a border. A tiling background rather than a
     wide inline SVG: a displacement filter stretched the full width of the
     viewport is the exact shape that makes Chromium give up rasterising, and
     seigaiha is a stencil pattern, so a regular repeat is truer to it than a
     hand-wobbled one would be. #}
  <div class="wave-border" aria-hidden="true"></div>

</div>
</body>
</html>
